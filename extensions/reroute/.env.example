# Reroute build-time configuration. Copy to `.env` in this directory (git-ignored) and fill in the
# values from the licence provider's dashboard. WXT exposes `WXT_*` variables to the extension
# through `import.meta.env`; nothing here is a secret (every id below travels in public checkout
# pages or in unauthenticated API request bodies), but keep real store credentials (API keys,
# organisation access tokens) out of this repo entirely.
#
# `scripts/write-env.ps1` at the repo root generates this file from the local secrets file;
# `-Sandbox` writes the Polar sandbox ids and API base instead.
#
# When the chosen provider's ids are missing or malformed the build still works: Pro gates stay
# closed and the options page shows "Licensing not configured".

# Which licence provider this build talks to: `polar` or `lemonsqueezy`. Optional: when unset the
# provider is inferred from the ids present (Polar if both Polar ids parse, else Lemon Squeezy).
WXT_LICENSE_PROVIDER=

# ---- Polar (https://polar.sh) ----------------------------------------------------------------
# Organisation id (Settings -> General). Sent in every licence request; public by design.
WXT_POLAR_ORGANIZATION_ID=

# Benefit id of the "Reroute Pro" licence-keys benefit (Benefits -> Reroute Pro -> copy id). Keys
# granted by any other benefit are rejected as "wrong product".
WXT_POLAR_BENEFIT_ID_REROUTE=

# Checkout link for Reroute Pro, e.g. https://buy.polar.sh/polar_cl_<id>.
# Optional: when empty, "Buy Pro" opens https://reroute.shantanuojha.com/#pro instead.
WXT_POLAR_CHECKOUT_URL_REROUTE=

# Organisation slug; "Restore purchase" opens https://polar.sh/<slug>/portal (the customer portal
# where buyers see their keys and free seats). Optional: falls back to the product page.
WXT_POLAR_ORG_SLUG=

# API origin. Leave empty for production (https://api.polar.sh); sandbox builds set
# https://sandbox-api.polar.sh, which also switches the portal link to sandbox.polar.sh.
WXT_POLAR_API_BASE=

# ---- Lemon Squeezy (retired once Polar is live) ----------------------------------------------
# Numeric store id (Settings -> Stores).
WXT_LEMONSQUEEZY_STORE_ID=

# Numeric variant id of the "Reroute Pro" product ($9 one-time). Keys bought for any other variant
# are rejected as "wrong product".
WXT_LEMONSQUEEZY_VARIANT_ID_REROUTE=

# Hosted checkout URL for that variant, e.g. https://browserforge.lemonsqueezy.com/checkout/buy/<uuid>.
# Optional: when empty, "Buy Pro" opens https://reroute.shantanuojha.com/#pro instead.
WXT_LEMONSQUEEZY_CHECKOUT_URL_REROUTE=
