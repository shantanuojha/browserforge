# Arbor build-time configuration. Copy to `.env` in this directory (git-ignored) and fill in the
# values from the Lemon Squeezy dashboard. WXT exposes `WXT_*` variables to the extension through
# `import.meta.env`; nothing here is a secret (all three values are public in the checkout page),
# but keep real store credentials (API keys) out of this repo entirely.
#
# When any id is missing or malformed the build still works: Pro gates stay closed and the options
# page shows "Licensing not configured".

# Numeric store id (Settings -> Stores).
WXT_LEMONSQUEEZY_STORE_ID=

# Numeric variant id of the "Arbor Pro" product ($15 one-time). Keys bought for any other variant
# are rejected as "wrong product".
WXT_LEMONSQUEEZY_VARIANT_ID_ARBOR=

# Hosted checkout URL for that variant, e.g. https://browserforge.lemonsqueezy.com/checkout/buy/<uuid>.
# Optional: when empty, "Buy Pro" opens https://browserforge.dev/arbor#pro instead.
WXT_LEMONSQUEEZY_CHECKOUT_URL_ARBOR=
